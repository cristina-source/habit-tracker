# ─── Base de Dados ────────────────────────────────────────────────────────────
# URL de ligação PostgreSQL (Vercel Postgres, Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/habit_tracker

# ─── Autenticação (NextAuth v5) ───────────────────────────────────────────────
# Gerar com: openssl rand -base64 32
AUTH_SECRET=your_nextauth_secret_here

# URL base da aplicação (sem barra final)
NEXTAUTH_URL=http://localhost:3004

# ─── Google OAuth + Calendar ─────────────────────────────────────────────────
# Criar em: https://console.cloud.google.com → APIs & Services → Credentials
# Scopes necessários: openid email profile https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Encriptação de Tokens Google ────────────────────────────────────────────
# Chave AES-256 de 32 bytes em hex (64 caracteres)
# Gerar com: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ─── IA — Geração de Receitas (Claude API) ───────────────────────────────────
# Obter em: https://console.anthropic.com
# Nota: a variável usada pelo gerador de receitas é RECIPE_AI_API_KEY
# Se não definida ou igual a "TODO", usa receitas de exemplo (mock)
RECIPE_AI_API_KEY=sk-ant-your-api-key-here
